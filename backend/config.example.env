# Copy this file to  config.env  and fill in the real values.
# config.env is gitignored — it holds secrets and is used only locally
# (by verify_hermes.sh and as a reference for what to seed into OpenBao).

# ── Hermes (local LLM, OpenAI-compatible) ──────────────────────────────
# From your laptop, reach Hermes on its MetalLB LoadBalancer IP:
HERMES_BASE_URL=http://192.168.179.20:8642/v1
# (in-cluster the bot uses http://hermes-api.kubevirt-vms.svc.cluster.local:8642/v1)
HERMES_MODEL=SET_ME           # exact model name — discover with: GET /v1/models
HERMES_API_KEY=SET_ME         # Hermes requires an API key

# ── Whisper STT ────────────────────────────────────────────────────────
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2   # or: tiny | base | small | medium | large-v3
WHISPER_COMPUTE_TYPE=int8

# ── Piper TTS ──────────────────────────────────────────────────────────
PIPER_VOICE=ru_RU-irina-medium   # alt: ru_RU-dmitri-medium, ru_RU-ruslan-medium

# ── STUNner TURN (browser WebRTC media relay) ──────────────────────────
# Seed these into OpenBao at  secret/voice-assistant/turn
STUNNER_TURN_USERNAME=voiceassistant
STUNNER_TURN_PASSWORD=SET_ME      # generate a random string

# ── ESP32 forward-compat ───────────────────────────────────────────────
# Set to true when the ReSpeaker XVF3800 / XIAO ESP32-S3 firmware client
# (see ./firmware/) is connecting. Activates esp32_munge() in app/bot.py —
# rewrites the SDP answer to drop sha-384/sha-512 fingerprints (ESP32
# mbedTLS only does sha-256) and rewrites STUNner relay candidates as host
# candidates (minimal SDP parser). Leave false for browser-only deployments.
ESP32_COMPAT=false
