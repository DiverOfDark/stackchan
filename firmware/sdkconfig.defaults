# --- chip / clocks ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# The partition table (partitions.csv) is written by espflash, see .cargo/config.toml.

# --- PSRAM (StackChan Core: 8 MB) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- console over the built-in USB-Serial-JTAG ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- tasks ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- app rollback (PRD FR-25) ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- size ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- caches: the framebuffer lives in PSRAM ---
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# --- TLS: mbedTLS buffers in PSRAM (RSA-4096 chain verification needs room) ---
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- camera: GC0308 over the shared legacy I2C driver, port 1 ---
CONFIG_SCCB_HARDWARE_I2C_DRIVER_LEGACY=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
CONFIG_GC0308_SUPPORT=y
CONFIG_CAMERA_CORE0=n
CONFIG_CAMERA_CORE1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_CAMERA_PSRAM_DMA=y
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=16384

# --- internal RAM budget ---
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=24

# --- voice: TLS to the backend (WebSocket) and audio ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# No variable-length record buffers: shrinking them broke streaming reads
# (mbedTLS -0x7100 a few seconds into reply audio). The buffers live in
# PSRAM (EXTERNAL_MEM_ALLOC), so fixed 16 KB costs no internal RAM.
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=n
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# WebSocket client: keep the single send/receive lock (the default). A
# separate TX lock lets the uplink sender write while the client task reads,
# and one mbedTLS context can't do both: reads fail with -0x7100 as soon as
# reply audio arrives mid-uplink. Sends just wait; the backlog absorbs it.
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=y

# --- internal RAM: keep driver code in flash (IRAM shares SRAM with the heap) ---
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HTTPD_WS_SUPPORT=y

# --- diagnostics: per-task CPU for /api/tasks ---
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
